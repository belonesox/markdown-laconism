{
  "name": "markdown-laconism",
  "displayName": "Markdown laconism",
  "description": "Include Markdown, text files, CSV and XLSX tables with ![], embed WebM video and auto-link file paths.",
  "version": "0.7.0",
  "icon": "media/icon.png",
  "license": "MIT",
  "author": "belonesox",
  "publisher": "belonesox",
  "repository": {
    "type": "git",
    "url": "https://gitverse.ru/belonesox/markdown-laconism.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "notebookRenderer": [
      {
        "id": "markdown-laconism-notebook",
        "displayName": "Markdown Laconism Notebook Features",
        "entrypoint": "./notebook-renderer.js",
        "requires": [
          "vscode.markdown-it-renderer"
        ]
      }
    ],
    "markdown.previewCommandLinks": [
      "markdown-laconism.launch",
      "markdown-laconism.find"
    ],
    "configuration": {
      "title": "Markdown Laconism",
      "properties": {
        "markdown-laconism.debug": {
          "type": "boolean",
          "default": true,
          "description": "Enable verbose logging to the Output Channel."
        }
      }
    }
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "qrcode-svg": "^1.1.0",
    "ssf": "^0.11.2"
  }
}
